# Copy to .env for local runs.  NEVER commit .env .
# In GitHub, these go in Settings -> Secrets and variables -> Actions.

# --- Neon Postgres (free plan, no card) ---------------------------------
# Dashboard -> your project -> Connection string -> "Pooled connection".
# Must end with ?sslmode=require
NEON_DSN=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# --- Groq (free tier, no card) ------------------------------------------
# https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# --- Cloudflare Workers AI (free fallback, no card) ---------------------
# Dashboard -> Workers & Pages -> account ID in the URL.
# Token needs: Workers AI (Read + Edit)
CF_ACCOUNT_ID=
CF_API_TOKEN=

# --- Notion (free plan) -------------------------------------------------
# https://www.notion.so/profile/integrations -> new internal integration.
# Then open EACH database -> ... -> Connections -> add your integration.
NOTION_TOKEN=ntn_...
NOTION_VERSION=2026-03-11
# Data source IDs, NOT database IDs. See README, "Notion (optional)".
NOTION_DS_WEEKS=
NOTION_DS_ITEMS=
NOTION_DS_THREADS=

# --- Telegram (free) ----------------------------------------------------
# Message @BotFather -> /newbot. Then message your own bot once and visit
# https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id.
TELEGRAM_TOKEN=
TELEGRAM_CHAT=
